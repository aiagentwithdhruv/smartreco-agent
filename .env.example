# SmartReco configuration — copy to .env and fill in.
# .env is gitignored. Never commit a real key.

# --- Mesh API (the ONLY LLM gateway this project talks to) -------------------
# Key looks like rsk_...  Get one at https://meshapi.ai
MESH_API_KEY=
MESH_BASE_URL=https://api.meshapi.ai/v1
# Chat model for the recommendation narrative. minimax/m2-her is free on Mesh, so
# this works on a zero-balance account. MESH_CHAT_MODEL is accepted as an alias.
MESH_MODEL=minimax/m2-her
# Embedding model used to index the catalog. Mesh has NO free embedding model
# (checked 4 Aug 2026: 997 models, 3 free, none of them embeddings), so this one
# returns HTTP 402 until the account has balance. Cheapest option at $0.002/1M.
MESH_EMBEDDING_MODEL=google/embeddinggemma-300m

# Which embedder to use:
#   local    (default) all-MiniLM-L6-v2 through Chroma's ONNX runtime; real semantic
#            vectors, runs offline, downloads ~80 MB once. No external API is called,
#            so the only calls leaving the machine are chat completions to Mesh.
#   mesh     force Mesh — errors if the key is missing, 402s without balance
#   auto     Mesh if a key is set, falling back to `local` on the first failure
#   hashing  deterministic lexical feature hashing; no downloads. Used by the tests.
EMBEDDINGS=local

# With no MESH_API_KEY the app still runs end to end: embeddings go local and the
# agent writes a clearly-labelled rule-based narrative instead of an LLM one.
# Nothing ever fakes a model call.

# --- App --------------------------------------------------------------------
# Signs the session cookie. Change this in any real deployment.
SESSION_SECRET=dev-secret-change-me
DATABASE_URL=sqlite:///./smartreco.sqlite3
CHROMA_DIR=./.chroma

# --- Trigger engine (how often the agent is allowed to think) ---------------
# Recompute after this many meaningful events since the last recommendation.
TRIGGER_MIN_EVENTS=8
# Hard floor between two LLM-backed recomputes for the same user (seconds).
TRIGGER_COOLDOWN_SECONDS=300
# A recommendation older than this (with new activity) is considered stale.
TRIGGER_STALENESS_MINUTES=30
# Products pulled from the vector store per recommendation.
RETRIEVAL_TOP_K=6

# --- Daily recommendation digest (stored recommendations only; never generates) ---
DIGEST_ENABLED=false
DIGEST_HOUR=18
# Telegram wins when both values are set. Keep the bot token only in .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Otherwise SMTP is used when SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional LangSmith tracing. Empty means tracing is fully off.
LANGCHAIN_API_KEY=
